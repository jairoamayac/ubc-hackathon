{
  // House Money: Next.js static export + a small edge API (worker/index.ts) on one Cloudflare Worker.
  // Build first: `npm run build` (writes ./out), then `npx wrangler deploy`.
  // Secret: `npx wrangler secret put SPONSOR_KEY` (JSON array of the devnet sponsor keypair).
  // Optional secret: `npx wrangler secret put QUICKNODE_URL` (private RPC, see docs/quicknode.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "house-money-ubc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Grok Bot appeals council (worker/grok.ts). Stores disputes and the proof screenshot for 7 days.
  // Wrangler 4.45+ creates this namespace on the first deploy. On older versions run
  // `npx wrangler kv namespace create DISPUTES` and add "id" here.
  // Secrets (never commit them): npx wrangler secret put GROK_WEBHOOK_URL, GROK_WEBHOOK_KEY,
  // and, if the QuickNode Stream is used, QUICKNODE_STREAM_SECRET.
  "kv_namespaces": [{ "binding": "DISPUTES" }],
  "vars": {
    "RPC_URL": "https://api.devnet.solana.com",
    "MINT": "FBQJKyDd5vSekrT4jVMVZRiXsrfCTW6nNBf5x5siKPWn",
    // Kamino Lend on devnet (public addresses): market, hmUSD reserve, Pyth USDC/USD feed. Locked pots earn here.
    "KAMINO_MARKET": "G5m4WrATTWncPShWDRkagCM934FYezTRYd2C69sTWkJQ",
    "KAMINO_RESERVE": "JBiEdktmtJsrrzhmHsfFSZqt2x6SLBjTwm9grDmupGZ6",
    "KAMINO_ORACLE": "Dpw1EAVrSB1ibxiDQyTAW6Zip3J4Btk2x4SgApQCeFbX"
  }
}
