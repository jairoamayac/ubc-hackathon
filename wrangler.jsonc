{
  // House Money demo: Next.js static export served by a Cloudflare Worker (static assets only, no server code yet).
  // Build first: `npm run build` (writes ./out), then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "house-money-ubc",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
